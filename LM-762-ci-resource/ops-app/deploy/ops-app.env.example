# Copy to ops-app.env (same folder) and fill in. ops-app.env is in .gitignore: never commit it.
# install-services.ps1 limits the file's ACL to the service user + Administrators.

# ── reverse proxy (Caddy) ──
OPS_DOMAIN=release-desk.example.com
OPS_AUTH_USER=release
# bcrypt hash, from:  caddy hash-password --plaintext '<password>'
OPS_AUTH_HASH=

# ── server ──
OPS_PORT=8765
# server.py answers only these Host names (plus localhost); OPS_DOMAIN is added automatically
# OPS_ALLOWED_HOSTS=release-desk.lan,192.168.1.20
# Caddy: client IPs allowed at all (default: private ranges + Tailscale 100.64.0.0/10)
# OPS_ALLOW_IPS=private_ranges 100.64.0.0/10
# Backups: a folder on another disk / NAS / synced drive for the daily off-host copy (backup.py)
# OPS_BACKUP_COPY_TO=D:\release-desk-backups
# Refresh alerts: ntfy topic URL or a webhook that accepts a plain-text POST (else a local pop-up on failure)
# OPS_ALERT_URL=

# ── Cloudflare Tunnel + Access (deploy/CLOUDFLARE.md) ──
# token of the tunnel made in the Zero Trust dashboard (Networks > Tunnels > Create > Cloudflared > copy the token)
# OPS_TUNNEL_TOKEN=
# the public name you mapped to http://127.0.0.1:8765, e.g. release-desk.example.com (server.py then accepts it and
# refuses any request for it that did not pass Cloudflare Access)
# OPS_TUNNEL_HOSTNAME=

# ── Cloudflare Pages + Access (deploy/CLOUDFLARE.md, "Cloudflare Pages"; no domain needed) ──
# OPS_PAGES_PROJECT=release-desk-xyz         -> https://release-desk-xyz.pages.dev
# CLOUDFLARE_API_TOKEN=                      API token, permission "Account > Cloudflare Pages > Edit" only
# CLOUDFLARE_ACCOUNT_ID=
# OPS_PAGES_AUTO=1                           refresh.ps1 also uploads each new build (default off)

# ── release decisions + daily digest (expert review round 2) ──
# who records decisions with backend/decide.py when --by is not given
# OPS_RELEASE_OWNER=
# post the daily digest (logs/digest-<day>.md, no GitHub logins) to an ntfy topic / webhook; off when empty
# OPS_DIGEST_URL=

# ── mode C: scheduled refresh (collectors call GitHub and Buildkite) ──
# The scheduled task runs without a desktop session, so the gh keyring login is not visible to it: give a token.
# Fine-grained, read-only, public repo LMCache/LMCache is enough.
GH_TOKEN=
# Buildkite: read_builds + read_pipelines (+ read_build_logs for failed-job lines)
BUILDKITE_API_TOKEN=

# optional overrides
# OPS_PYTHON=C:\Path\to\python.exe
# OPS_CADDY=C:\Path\to\caddy.exe
# OPS_PRIVACY_WORDS=word1,word2     extra words the privacy scan must never find in the served tree

# ── Cloudflare database copy and web refresh (review 9.6: every setting the code reads is listed here) ──
# The Cloudflare token needs: Pages Edit, D1 Edit, Workers KV Storage Edit (one token, or set them per script).
# OPS_D1_DB=            # D1 database id, printed by: python -X utf8 d1_sync.py init
# OPS_D1_NAME=release-desk
# OPS_D1_KEEP=7         # snapshots kept in D1 (= how far d1_sync.py rollback can go)
# OPS_D1_DAYS=90        # public window: D1 gets the last N days only (0 = all); the local ops.db keeps everything
# OPS_D1_DAILY_WRITES=90000  # stop a push BEFORE writing if it would pass this many D1 rows written today (free plan: 100k)
# OPS_KV_NS=            # KV namespace id of the "Refresh data" queue (binding RD_CTL), see setup_web_refresh.py
# OPS_ACCESS_EMAIL_DOMAIN=   # cf_access.py: allowed e-mail domain when Cloudflare Access is used
# OPS_KB_REVIEWER=      # kb.py: who signs off knowledge-base proposals
# OPS_NODE_DIR=         # folder of node/npx when it is not on PATH (wrangler)
# OPS_CLOUDFLARED=      # path of cloudflared.exe (run-tunnel.ps1)
